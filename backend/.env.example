APP_NAME=药食同源知识问答平台
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_DSN=postgresql+psycopg://postgres:1234@localhost:5432/postgres
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=3217858658
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_REASONING_SPLIT=true
MAX_GRAPH_NODES=40
MAX_GRAPH_EDGES=80
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_COMPLETION_TOKENS=1200
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
AUTH_SESSION_TTL_HOURS=24
# --- 认证/账号基座 ---
# 登录/注册图形验证码开关（true 要求登录/注册携带 captcha_id + captcha_text）
CAPTCHA_ENABLED=true
# 验证码字符长度（base 默认 4）
CAPTCHA_LENGTH=4
# 验证码有效期（秒）
CAPTCHA_TTL_SECONDS=300
# 验证码最大失败尝试次数，超过即作废
CAPTCHA_FAIL_MAX=5
# 同一用户允许的最大并发会话数（超出挤掉最旧会话）
AUTH_MAX_SESSIONS_PER_USER=5
# 密码最小长度（注册/改密校验）
PASSWORD_MIN_LENGTH=8
# 登录失败锁定分钟数（后续登录限流策略使用）
LOGIN_FAIL_LOCK_MINUTES=15
